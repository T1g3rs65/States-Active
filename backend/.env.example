# ===== States-Active backend environment (example) =====
# Copy to `.env` and fill in values. `server.py` loads this via python-dotenv.

# --- OpenClaw gateway (AI model routing) ---
# Token for the local OpenClaw gateway. Find it in ~/.openclaw/openclaw.json
# under `gateway.auth.token`. The backend calls the gateway's OpenAI-compatible
# endpoint (default http://127.0.0.1:18789/v1) with `Authorization: Bearer <token>`.
OPENCLAW_GATEWAY_TOKEN=your-openclaw-gateway-token

# Optional: override the gateway base URL (default http://127.0.0.1:18789/v1)
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1

# --- MongoDB ---
# server.py reads MONGO_URL + DB_NAME. MONGODB_URL is the documented default
# (same value) for convenience.
#
# If MONGO_URL is NOT set, the backend falls back to an in-memory mock
# (mongomock-motor) so the LAN demo runs without installing MongoDB.
# Set MONGO_URL to use real MongoDB in production.
MONGODB_URL=mongodb://localhost:27017/states
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=states

# --- Server identity (optional) ---
# SERVER_NAME=My SovereignHex Server
# SERVER_DESCRIPTION=Welcome to my SovereignHex server!
# WORLD_SEED=123456
# MAX_PLAYERS=50
# ALLOW_MIGRATION=true
# SERVER_VISIBILITY=public
# SERVER_VERSION=1.0.0
# SERVER_HOST_URL=http://localhost:8001
# ENABLED_RACES=human,zythera
