# SovereignHex - All-in-One Standalone Server
# This image includes MongoDB for true one-command hosting
# 
# Usage:
#   docker run -d -p 8001:8001 -v sovereignhex-data:/data/db sovereignhex/server:standalone
#
# Or with custom settings:
#   docker run -d -p 8001:8001 \
#     -e SERVER_NAME="My World" \
#     -e WORLD_SEED="12345" \
#     -v sovereignhex-data:/data/db \
#     sovereignhex/server:standalone

FROM python:3.11-slim

# Install MongoDB and dependencies
RUN apt-get update && apt-get install -y \
    gnupg \
    curl \
    gcc \
    supervisor \
    && curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg \
    && echo "deb [ signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] http://repo.mongodb.org/apt/debian bookworm/mongodb-org/7.0 main" | tee /etc/apt/sources.list.d/mongodb-org-7.0.list \
    && apt-get update \
    && apt-get install -y mongodb-org \
    && rm -rf /var/lib/apt/lists/*

# Create directories
WORKDIR /app
RUN mkdir -p /data/db /var/log/supervisor

# Copy requirements and install
COPY requirements_server.txt .
RUN pip install --no-cache-dir -r requirements_server.txt

# Copy application code
COPY *.py ./

# Copy supervisor config
RUN echo '[supervisord]\n\
nodaemon=true\n\
logfile=/var/log/supervisor/supervisord.log\n\
\n\
[program:mongodb]\n\
command=/usr/bin/mongod --bind_ip_all\n\
autostart=true\n\
autorestart=true\n\
stderr_logfile=/var/log/supervisor/mongodb.err.log\n\
stdout_logfile=/var/log/supervisor/mongodb.out.log\n\
\n\
[program:sovereignhex]\n\
command=uvicorn server:app --host 0.0.0.0 --port 8001\n\
directory=/app\n\
autostart=true\n\
autorestart=true\n\
stderr_logfile=/var/log/supervisor/sovereignhex.err.log\n\
stdout_logfile=/var/log/supervisor/sovereignhex.out.log\n\
' > /etc/supervisor/conf.d/sovereignhex.conf

# Environment variables with defaults
ENV SERVER_NAME="SovereignHex Server"
ENV SERVER_DESCRIPTION="A SovereignHex game server"
ENV WORLD_SEED="123456"
ENV MAX_PLAYERS="50"
ENV SERVER_VISIBILITY="public"
ENV SERVER_VERSION="1.0.0"
ENV ALLOW_MIGRATION="true"
ENV MONGO_URL="mongodb://localhost:27017"
ENV DB_NAME="sovereignhex"

# Expose the API port
EXPOSE 8001

# Volume for persistent data
VOLUME ["/data/db"]

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8001/api/server/info || exit 1

# Run supervisor (manages both MongoDB and the game server)
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/sovereignhex.conf"]
